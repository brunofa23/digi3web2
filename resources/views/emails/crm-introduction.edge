<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f6f9;font-family:Arial,Helvetica,sans-serif;color:#203247;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f6f9;padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden;">
            <tr>
              <td style="padding:22px 32px;background:#12334d;border-bottom:4px solid #0796d2;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td valign="middle" style="padding-right:14px;"><img src="cid:digi3-logo" width="54" height="48" alt="Logo Digi3" style="display:block;width:54px;height:48px;border:0;"></td>
                    <td valign="middle" style="font-size:23px;font-weight:bold;letter-spacing:.3px;color:#ffffff;">Digi3</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:34px 36px 30px;">
                <p style="margin:0 0 10px;color:#0785be;font-size:12px;font-weight:bold;letter-spacing:1.4px;text-transform:uppercase;">Tecnologia para cartórios</p>
                <h1 style="margin:0 0 22px;color:#12334d;font-size:27px;line-height:1.25;">Mais cuidado e agilidade para o seu acervo</h1>
                <div style="font-size:16px;line-height:1.7;color:#405367;white-space:pre-line;">{{ description }}</div>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:26px 0 8px;">
                  <tr>
                    <td style="border-radius:6px;background:#0785be;"><a href="https://digi3sistemas.com.br" style="display:inline-block;padding:13px 20px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;">Conheça a Digi3</a></td>
                  </tr>
                </table>
                <p style="margin:24px 0 0;color:#758496;font-size:13px;line-height:1.5;">Soluções digitais para preservar, organizar e consultar acervos cartorários.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:17px 32px;background:#f7f9fb;border-top:1px solid #e8edf2;color:#748394;font-size:12px;line-height:1.5;">
                Digi3 Sistemas · Tecnologia e gestão para cartórios
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
